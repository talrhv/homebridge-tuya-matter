{
  "pluginAlias": "TuyaPlatformMatter",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "Homebridge Tuya Matter, by Tal Rahav.",
  "footerDisplay": "",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "TuyaPlatformMatter",
        "description": "You shouldn't need to change this."
      },
      "options": {
        "title": "",
        "type": "object",
        "properties": {
          "username": {
            "title": "Username",
            "type": "string"
          },
          "password": {
            "title": "Password",
            "type": "string"
          },
          "accessId": {
            "title": "Access ID",
            "type": "string"
          },
          "accessKey": {
            "title": "Access Key",
            "type": "string"
          },
          "lang": {
            "title": "Language Code",
            "type": "string",
            "default": "en",
            "description": "Your two letter language code"
          },
          "projectType": {
            "title": "Project Type",
            "type": "string",
            "default": "form",
            "oneOf": [
              { "title": "PaaS", "enum": ["2"] },
              { "title": "Custom", "enum": ["1"] }
            ]
          },
          "appSchema": {
            "title": "PaaS Platform",
            "type": "string",
            "default": "form",
            "oneOf": [
              { "title": "Tuya Smart", "enum": ["tuyaSmart"] },
              { "title": "Smart Life", "enum": ["smartlife"] }
            ]
          },
          "countryCode": {
            "title": "Country Code",
            "type": "number",
            "default": "",
            "description": "Your two integer country code"
          },
          "endPointOverride": {
            "title": "API Endpoint Override",
            "type": "string",
            "description": "Override the Tuya API server selected automatically from your country code. Use this if your devices fail to connect, appear offline, or you receive authentication errors — some users in certain regions are routed to the wrong server by default. Leave set to Auto for normal operation.",
            "oneOf": [
              { "title": "Americas (US, Canada, Latin America)", "enum": ["https://openapi.tuyaus.com"] },
              { "title": "Europe (EU, UK, Middle East, Africa)", "enum": ["https://openapi.tuyaeu.com"] },
              { "title": "India", "enum": ["https://openapi.tuyain.com"] },
              { "title": "China", "enum": ["https://openapi.tuyacn.com"] }
            ]
          },
          "valve": {
            "title": "switch with timer",
            "type": "array",
            "description": "This feature let you use the switch as a valve accessory...",
            "items": {
              "type": "object",
              "properties": {
                "deviceId": { "title": "Device Id", "type": "string" },
                "protocol": {
                  "title": "Apply to",
                  "type": "string",
                  "default": "hap",
                  "oneOf": [
                    { "title": "None", "enum": ["none"] },
                    { "title": "HAP only", "enum": ["hap"] },
                    { "title": "Matter only", "enum": ["matter"] },
                    { "title": "Both", "enum": ["both"] }
                  ]
                }
              }
            }
          },
          "motion": {
            "title": "Motion sensors",
            "type": "array",
            "description": "...",
            "items": {
              "type": "object",
              "properties": {
                "deviceId": { "title": "Device Id", "type": "string" },
                "overrideTuya": {
                  "title": "Enable time modification",
                  "type": "integer",
                  "default": 0,
                  "oneOf": [
                    { "title": "0", "enum": [0] },
                    { "title": "15", "enum": [15] },
                    { "title": "30", "enum": [30] },
                    { "title": "45", "enum": [45] },
                    { "title": "60", "enum": [60] },
                    { "title": "75", "enum": [75] },
                    { "title": "90", "enum": [90] },
                    { "title": "105", "enum": [105] },
                    { "title": "120", "enum": [120] }
                  ]
                }
              }
            }
          },
          "ignoreDevices": {
            "title": "Ignore specific devices",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "deviceId": { "title": "Device ID", "type": "string" },
                "ignoreFor": {
                  "title": "Ignore for",
                  "type": "string",
                  "default": "both",
                  "oneOf": [
                    { "title": "Both HAP and Matter", "enum": ["both"] },
                    { "title": "HAP only", "enum": ["hap"] },
                    { "title": "Matter only", "enum": ["matter"] }
                  ]
                }
              },
              "required": ["deviceId", "ignoreFor"]
            }
          },
          "troubleshooting": {
            "title": "Troubleshooting",
            "type": "object",
            "expandable": true,
            "expanded": false,
            "properties": {
              "devices": {
                "title": "Per-device UUID override",
                "type": "array",
                "description": "Manual override (rarely needed). The bridge now automatically resets a device's Apple Home identity whenever it is removed and re-added, so this section is only for forcing a reset manually. Set a UUID Salt for the affected device and restart to force Apple Home to treat it as brand-new. If the issue ever recurs, increase the salt by 1 (to 2, then 3, etc.) and restart again.",
                "items": {
                  "type": "object",
                  "properties": {
                    "deviceId": { "title": "Device ID", "type": "string" },
                    "uuidSalt": {
                      "title": "UUID Salt",
                      "type": "integer",
                      "default": 1,
                      "minimum": 1,
                      "description": "Increment this by 1 each time you need to reset this device's Apple Home state. Keep the current value stable until the issue reoccurs."
                    }
                  },
                  "required": ["deviceId"]
                }
              }
            }
          },
          "debug": {
            "title": "Enable Debug Logging",
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "username",
          "password",
          "accessId",
          "accessKey",
          "lang",
          "projectType",
          "appSchema",
          "countryCode",
          "debug"
        ]
      }
    },
    "required": ["name", "options"]
  }
}